APP_NAME=MotaCast
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Caracas
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local development uses sqlite; Production container uses MariaDB
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=mariadb
# DB_PORT=3306
# DB_DATABASE=motacast
# DB_USERNAME=motacast
# DB_PASSWORD=SecureMotaCast2026!

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

PLATFORM_PREFIX=/orchid
